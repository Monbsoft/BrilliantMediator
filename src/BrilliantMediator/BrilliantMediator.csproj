<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<IsPackable>true</IsPackable>
    <RootNamespace>Monbsoft.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	  <!-- Package info -->
	  <PackageId>BrilliantMediator</PackageId>
	  <Title>BrilliantMediator</Title>
	  <Description>Ultra-lightweight, zero-reflection mediator for .NET with blazing performance</Description>
	  <Version>1.2.0</Version>
	  <Authors>Monbsoft</Authors>
	  <PackageProjectUrl>https://github.com/Monbsoft/BrilliantMediator</PackageProjectUrl>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <RepositoryUrl>https://github.com/Monbsoft/BrilliantMediator</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageTags>mediator;cqrs;command;query;performance</PackageTags>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
