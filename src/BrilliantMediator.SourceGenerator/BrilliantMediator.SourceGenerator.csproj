<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Package info -->
    <IsPackable>true</IsPackable>
    <PackageId>BrilliantMediator.SourceGenerator</PackageId>
    <Title>BrilliantMediator.SourceGenerator</Title>
    <Description>Roslyn Source Generator for BrilliantMediator — zero-reflection handler registration at compile time.</Description>
    <Version>3.0.0</Version>
    <Authors>Monbsoft</Authors>
    <PackageProjectUrl>https://github.com/Monbsoft/BrilliantMediator</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Monbsoft/BrilliantMediator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mediator;cqrs;sourcegenerator;roslyn;codegen</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
